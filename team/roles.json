      "never": ["直接改 core/ 实现"]
    },
    {
      "id": "core-dev",
      "name": "领域层",
      "owns": ["core/", "storage/", "test/core.test.mjs", "test/storage.test.mjs"],
      "done": ["node --test 全绿", "不引第三方依赖"],
      "never": ["碰 host/ 的 HTTP 细节", "改 event 形状不升版本"]
    },
    {
      "id": "host-dev",
      "name": "宿主层",
