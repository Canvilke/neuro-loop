      "never": ["改 data/seed.json 的既有 id"]
    },
    {
      "id": "content",
      "name": "内容",
      "owns": ["daily/", "plan/", "content/", "tools/make_docx.py", "tools/en_page.py"],
      "done": ["1 页装完", "语言客观、无第二人称"],
      "never": ["改代码逻辑"]
    },
    {
      "id": "qa",
      "name": "验证",
      "owns": ["test/", "tools/check_all.ps1"],
      "done": ["每票的 accept 逐条给出证据", "失败写清复现步骤"],
      "never": ["为了让测试过而改断言"]
    }
  ]
