{
  "version": 1,
  "note": "角色契约：子代理每次只读自己那一份；scope 之外的文件默认不改。",
  "roles": [
    {
      "id": "architect",
      "name": "架构",
      "owns": ["docs/", "AGENTS.md", "README.md"],
